{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "basic-stripe",
          "appId": "1:875225395768:android:5cb8119aea3afb067daccd",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "basic-stripe",
          "configurations": {
            "android": "1:875225395768:android:5cb8119aea3afb067daccd",
            "ios": "1:875225395768:ios:22442f9968c297fa7daccd",
            "macos": "1:875225395768:ios:22442f9968c297fa7daccd",
            "web": "1:875225395768:web:23526ac0638355747daccd"
          }
        }
      }
    }
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  }
}
